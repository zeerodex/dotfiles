#!/usr/bin/env bash

TARGET="/sys/class/power_supply/BAT0/charge_types"

case "$1" in
    fast|f)
        echo "Fast" | sudo tee "$TARGET" > /dev/null
        echo "Current mode: Fast Charging"
        ;;
    standard|std|s)
        echo "Standard" | sudo tee "$TARGET" > /dev/null
        echo "Current mode: Standard (100%)"
        ;;
    save|conservation|long_life|l)
        echo "Long_Life" | sudo tee "$TARGET" > /dev/null
        echo "Current mode: Battery Conservation (Long_Life)"
        ;;
    ""|status)
        cat "$TARGET"
        ;;
    *)
        echo "Usage: charge-mode [fast|standard|long_life|status]"
        ;;
esac
