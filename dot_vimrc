set nocompatible
syntax on
filetype plugin indent on

set number
set relativenumber
set showmatch
set scrolloff=5

set expandtab
set tabstop=4
set shiftwidth=4
set autoindent
set smartindent

set incsearch
set hlsearch
set ignorecase
set smartcase

set mouse=a

nnoremap Y "+y
vnoremap Y "+y
nnoremap YY "+yy
