# --- Layout & Geometry ---
max-visible=5
sort=-time
layer=top
anchor=top-right
width=360
height=110
margin=20
padding=15
border-size=1
border-radius=0

# --- Text & Icons ---
font={{ .fonts.family}} {{ (index .fonts .machine).mako }}
icons=1
icon-path=/usr/share/icons/Papirus
max-icon-size=48
default-timeout=5000

# --- Interaction Bindings ---
on-button-left=dismiss
on-button-right=dismiss-all
on-button-middle=invoke-default-action

# --- Dynamic Theme Import ---
# This pulls in the wallpaper colors generated by Matugen
include=~/.config/mako/mako-colors
