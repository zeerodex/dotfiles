local term          = "foot"
local file_manager  = "thunar"
local launcher      = "rofi -show drun"
local code_editor   = "zeditor"
local powermenu     =
"rofi -modi 'power:~/.config/rofi/scripts/power.sh' -show power -theme-str 'window {width: 10em;} listview {lines: 5;}'"
local clipboard     = "rofi -modi 'clipboard:~/.config/rofi/scripts/cliphist.sh' -show clipboard"
local clipboard_img =
"rofi -modi 'clipboard-img:~/.config/rofi/scripts/cliphist-img.sh' -show clipboard-img -show-icons -theme-str 'element-icon { size: 96px; } listview {lines: 5;}'"
local screenshot    = "~/.config/hypr/scripts/screenshot.sh"
local ocr           = "~/.config/hypr/scripts/ocr.sh"

-- Window management
hl.bind("SUPER + Q", hl.dsp.window.close())
hl.bind("SUPER + SHIFT + Q", hl.dsp.window.kill())
hl.bind("SUPER + V", hl.dsp.window.float({ action = "toggle" }))
hl.bind("SUPER + F", hl.dsp.window.fullscreen())
hl.bind("SUPER + P", hl.dsp.window.pin())
{{- if ne .layout "scrolling" }}
hl.bind("SUPER + U", hl.dsp.layout("togglesplit"))
{{- end }}

-- Window focus
hl.bind("SUPER + H", hl.dsp.focus({ direction = "left" }))
hl.bind("SUPER + J", hl.dsp.focus({ direction = "down" }))
hl.bind("SUPER + K", hl.dsp.focus({ direction = "up" }))
hl.bind("SUPER + L", hl.dsp.focus({ direction = "right" }))
hl.bind("SUPER + SPACE", function()
    local active = hl.get_active_window()

    if active and active.floating then
        hl.dispatch(hl.dsp.focus({ window = "tiled" }))
    else
        hl.dispatch(hl.dsp.focus({ window = "floating" }))
    end
end)

-- Window movement
hl.bind("SUPER + SHIFT + H", hl.dsp.window.move({ direction = "left" }))
hl.bind("SUPER + SHIFT + J", hl.dsp.window.move({ direction = "down" }))
hl.bind("SUPER + SHIFT + K", hl.dsp.window.move({ direction = "up" }))
hl.bind("SUPER + SHIFT + L", hl.dsp.window.move({ direction = "right" }))

{{ if eq .layout "scrolling" -}}
-- Scrolling layout
hl.bind("SUPER + period", hl.dsp.layout("move +col"))
hl.bind("SUPER + comma", hl.dsp.layout("move -col"))
hl.bind("SUPER + mouse_up", hl.dsp.layout("move +col"))
hl.bind("SUPER + mouse_down", hl.dsp.layout("move -col"))

hl.bind("SUPER + SHIFT + period", hl.dsp.layout("swapcol r"))
hl.bind("SUPER + SHIFT + comma", hl.dsp.layout("swapcol l"))

hl.bind("SUPER + R", hl.dsp.layout("colresize +conf"))
hl.bind("SUPER + SHIFT + R", hl.dsp.layout("colresize -conf"))

hl.bind("SUPER + SHIFT + F", hl.dsp.layout("fit active"))
hl.bind("SUPER + SHIFT + E", hl.dsp.layout("fit expand"))
{{ else -}}
-- Window resizing
hl.bind("SUPER + R", hl.dsp.submap("resize"))

hl.define_submap("resize", function()
    hl.bind("H", hl.dsp.window.resize({ x = -10, y = 0, relative = true }), { repeating = true })
    hl.bind("J", hl.dsp.window.resize({ x = 10, y = -10, relative = true }), { repeating = true })
    hl.bind("K", hl.dsp.window.resize({ x = 0, y = 10, relative = true }), { repeating = true })
    hl.bind("L", hl.dsp.window.resize({ x = 10, y = 0, relative = true }), { repeating = true })

    hl.bind("escape", hl.dsp.submap("reset"))
end)
{{- end }}

-- Applications
hl.bind("SUPER + RETURN", hl.dsp.exec_cmd(term))
hl.bind("SUPER + SHIFT + RETURN", hl.dsp.exec_cmd(term, { float = true, size = { 900, 600 } }))
hl.bind("SUPER + E", hl.dsp.exec_cmd(file_manager))
hl.bind("SUPER + Y", hl.dsp.exec_cmd("EDITOR=vim " .. term .. " -e yazi"))
hl.bind("SUPER + N", hl.dsp.exec_cmd(code_editor, { workspace = "name:code" }))
{{- if eq .machine "laptop" }}
hl.bind("XF86Calculator", hl.dsp.exec_cmd("qalculate-gtk"))
{{- else if eq .machine "desktop" }}
hl.bind("SUPER + B", hl.dsp.exec_cmd("qalculate-gtk"))
{{- end }}

-- Utilities
hl.bind("SUPER + D", hl.dsp.exec_cmd(launcher))
hl.bind("SUPER + ESCAPE", hl.dsp.exec_cmd(powermenu), { locked = true })
hl.bind("SUPER + SHIFT + ESCAPE", hl.dsp.exec_cmd("loginctl lock-session"))
hl.bind("SUPER + SHIFT + CTRL + ESCAPE", hl.dsp.exit(), { locked = true })
hl.bind("SUPER + T", hl.dsp.exec_cmd("localsend"))
hl.bind("SUPER + M", hl.dsp.exec_cmd("chezmoi apply"))

-- Clipboard
hl.bind("SUPER + SEMICOLON",
    hl.dsp.exec_cmd(clipboard))
hl.bind("SUPER + SHIFT + SEMICOLON",
    hl.dsp.exec_cmd(clipboard_img))

-- Screenshots
hl.bind("PRINT", hl.dsp.exec_cmd(screenshot .. " full"))
hl.bind("SUPER + SHIFT + S", hl.dsp.exec_cmd(screenshot .. " area-copy"))

hl.bind("SUPER + S", hl.dsp.submap("screenshot"))

hl.define_submap("screenshot", function()
    hl.bind("A", hl.dsp.exec_cmd(screenshot .. " area"))
    hl.bind("SHIFT + A", hl.dsp.exec_cmd(screenshot .. " area-copy"))
    hl.bind("CTRL + A", hl.dsp.exec_cmd(screenshot .. " area-satty"))

    hl.bind("F", hl.dsp.exec_cmd(screenshot .. " full"))
    hl.bind("SHIFT + F", hl.dsp.exec_cmd(screenshot .. " full-copy"))
    hl.bind("CTRL + F", hl.dsp.exec_cmd(screenshot .. " full-satty"))

    hl.bind("W", hl.dsp.exec_cmd(screenshot .. " window"))
    hl.bind("SHIFT + W", hl.dsp.exec_cmd(screenshot .. " window-copy"))
    hl.bind("CTRL + W", hl.dsp.exec_cmd(screenshot .. " window-satty"))

    hl.bind("L", hl.dsp.exec_cmd(screenshot .. " last-satty"))
    hl.bind("C", hl.dsp.exec_cmd(screenshot .. " clip-satty"))

    hl.bind("ESCAPE", hl.dsp.submap("reset"))
end)

-- OCR

hl.bind("SUPER + O", hl.dsp.submap("ocr"))

hl.define_submap("ocr", function()
    hl.bind("E", hl.dsp.exec_cmd(ocr .. " eng"))
    hl.bind("R", hl.dsp.exec_cmd(ocr .. " rus"))
    hl.bind("U", hl.dsp.exec_cmd(ocr .. " ukr"))
    hl.bind("ESCAPE", hl.dsp.submap("reset"))
end)

-- Volume controls
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"), { repeating = true })
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"), { repeating = true })
hl.bind("XF86AudioMute", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"), { locked = true })
{{- if eq .machine "laptop" }}
hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"), { locked = true })
{{- end}}

-- Media controls
hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("playerctl previous"), { locked = true })
hl.bind("XF86AudioNext", hl.dsp.exec_cmd("playerctl next"), { locked = true })
hl.bind("XF86AudioStop", hl.dsp.exec_cmd("playerctl stop"), { locked = true })

{{ if eq .machine "laptop" -}}
-- Brightness controls
hl.bind("XF86MonBrightnessUp", hl.dsp.exec_cmd("brightnessctl set +10%"), { locked = true })
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl set 10%-"), { locked = true })
{{- end}}

-- Numbered workspaces
for i = 1, 9 do
    hl.bind("SUPER + " .. i, hl.dsp.focus({ workspace = i }))
end

for i = 1, 9 do
    hl.bind("SUPER + SHIFT + " .. i, hl.dsp.window.move({ workspace = i, follow = true }))
end

for i = 1, 9 do
    hl.bind("SUPER + ALT + " .. i, hl.dsp.window.move({ workspace = i, follow = false }))
end

-- Named workspaces
hl.bind("SUPER + C", hl.dsp.focus({ workspace = "name:code" }))
hl.bind("SUPER + W", hl.dsp.focus({ workspace = "name:web" }))
hl.bind("SUPER + A", hl.dsp.focus({ workspace = "name:home" }))
hl.bind("SUPER + Z", hl.dsp.focus({ workspace = "name:memo" }))
hl.bind("SUPER + SHIFT + C", hl.dsp.window.move({ workspace = "name:code", follow = true }))
hl.bind("SUPER + SHIFT + W", hl.dsp.window.move({ workspace = "name:web", follow = true }))
hl.bind("SUPER + SHIFT + A", hl.dsp.window.move({ workspace = "name:home", follow = true }))
hl.bind("SUPER + SHIFT + Z", hl.dsp.window.move({ workspace = "name:memo", follow = true }))
hl.bind("SUPER + ALT + C", hl.dsp.window.move({ workspace = "name:code", follow = false }))
hl.bind("SUPER + ALT + W", hl.dsp.window.move({ workspace = "name:web", follow = false }))
hl.bind("SUPER + ALT + A", hl.dsp.window.move({ workspace = "name:home", follow = false }))
hl.bind("SUPER + ALT + Z", hl.dsp.window.move({ workspace = "name:memo", follow = false }))

-- Special workspace
hl.bind("SUPER + X", hl.dsp.workspace.toggle_special("scratchpad"))
hl.bind("SUPER + SHIFT + X", hl.dsp.window.move({ workspace = "special:scratchpad", follow = true }))
hl.bind("SUPER + ALT + X", hl.dsp.window.move({ workspace = "special:scratchpad", follow = false }))

-- Workspace navigation
hl.bind("SUPER + GRAVE", hl.dsp.focus({ workspace = "previous" }))

-- Mouse binds
hl.bind("SUPER + mouse:272", hl.dsp.window.drag(), { mouse = true })
hl.bind("SUPER + mouse:273", hl.dsp.window.resize(), { mouse = true })

{{ if eq .machine "desktop" -}}
-- Multi-monitor
hl.bind("SUPER + M", hl.dsp.workspace.swap_monitors({ monitor1 = "HDMI-A-1", monitor2 = "DP-1" }))
hl.bind("SUPER + F1", hl.dsp.focus({ monitor = "HDMI-A-1" }))
hl.bind("SUPER + F2", hl.dsp.focus({ monitor = "DP-1" }))
hl.bind("SUPER + SHIFT + F1", hl.dsp.workspace.move({ monitor = "HDMI-A-1" }))
hl.bind("SUPER + SHIFT + F2", hl.dsp.workspace.move({ monitor = "DP-1" }))
hl.bind("SUPER + SHIFT + M", function()
   local monitor = hl.get_monitor("DP-1")

   if monitor then
       hl.notification.create({ text = "Monitor DP-1 off", duration = 3000 })
       hl.monitor({
           output = "DP-1",
           disabled = true,
       })
   else
       hl.notification.create({ text = "Monitor DP-1 on", duration = 3000 })
       hl.monitor({
           output = "DP-1",
           disabled = false,
       })
   end
end)
{{- end}}
