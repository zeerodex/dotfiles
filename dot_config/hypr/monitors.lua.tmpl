{{- if eq .machine "laptop" -}}
hl.monitor({
    output = "eDP-1",
    mode = "1920x1200@60",
    position = "0x0",
    scale = 1,
})
{{- else if eq .machine "desktop" -}}
hl.monitor({
    output = "HDMI-A-1",
    mode = "1920x1080@240",
    position = "0x0",
    scale = 1,
    vrr = 2,
})

hl.monitor({
    output = "DP-1",
    mode = "1920x1080@60",
    position = "1920x0",
    scale = 1,
    vrr = 0,
    disabled = true,
})
{{- end }}
